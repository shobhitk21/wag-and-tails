# Root reference. Each package keeps its own .env.example:
#   backend/.env.example            DATABASE_URL, PORT, CORS_ORIGIN
#   web/staff-portal/.env.example   VITE_API_URL
#   web/admin-portal/.env.example   VITE_API_URL
#   apps/customer-app/.env.example  EXPO_PUBLIC_API_URL
#   apps/partner-app/.env.example   EXPO_PUBLIC_API_URL

DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082
JWT_SECRET=

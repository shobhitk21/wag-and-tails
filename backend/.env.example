# Copy to backend/.env and fill in.

# Neon (or any Postgres). sslmode=require is expected.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

PORT=4000

# Extra browser origins that may call the API, comma separated.
#
# In development you can leave this empty: any localhost or private-LAN origin
# is accepted on any port, which covers both web consoles and Expo web
# (which picks whichever port is free — 8081, 8082, 8084...), including when
# a phone reaches your machine over the LAN.
#
# With NODE_ENV=production only this list is honoured, so set it to the real
# public origins before deploying.
CORS_ORIGIN=

# Signs the staff/admin login tokens. Generate a real one for anything beyond
# your own machine — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Without it the server falls back to an insecure fixed string and warns on boot.
JWT_SECRET=

# How much faster than real time a live walk advances. 20 means a 45-minute
# walk finishes in about two minutes, which is what the prototype did.
WALK_SPEEDUP=20
